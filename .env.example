# Скопируйте этот файл в .env:  cp .env.example .env
#
# Учётные данные TradeMap здесь НЕ нужны: пользователь вводит их на странице
# входа, и приложение работает от его имени. Эти две переменные нужны только
# для диагностики из командной строки (python -m app.auth --check) — можно
# оставить пустыми.
TRADEMAP_USERNAME=
TRADEMAP_PASSWORD=

# Порт локального веб-приложения
TRADEMAP_PORT=8765

# Валюта по умолчанию: USD или EUR
TRADEMAP_CURRENCY=USD

# Ветка HS, которой ограничен список продуктов.
# 0713 — сушёные бобовые. Оставьте пустым, чтобы видеть весь классификатор.
TRADEMAP_PRODUCT_ROOT=0713

# Сколько знаков сверх корня показывать (0 — без ограничения).
# 6-значные коды общие для всех стран; всё, что длиннее, — национальные
# тарифные линии, и их глубина у стран РАЗНАЯ: Индия отчитывается на 8 знаках,
# Австралия и США — на 10. Значение 6 покрывает оба случая; поставьте 4,
# только если национальный уровень США и Австралии вам осознанно не нужен.
TRADEMAP_PRODUCT_EXTRA_MAX=6

# Предел числа запросов на один прогон. Каждая комбинация
# «страна × продукт × показатель» — отдельное обращение к API.
TRADEMAP_MAX_TASKS=200


# --- Только для деплоя на сервер (docker compose) ---------------------------
# При локальном запуске через ./run.sh эти переменные не нужны.

# Домен, A-запись которого указывает на IP сервера.
# Caddy выпишет для него сертификат Let's Encrypt автоматически.
TRADEMAP_DOMAIN=trademap.example.com

# Ключ подписи cookie сессии. Можно не задавать: приложение сгенерирует его
# само и сохранит в кэше. Задавайте, только если нужно, чтобы сессии
# переживали очистку кэша или работали на нескольких копиях приложения.
TRADEMAP_SESSION_SECRET=
