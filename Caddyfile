# Caddy сам получает и продлевает сертификат Let's Encrypt для указанного домена.
# Требование одно: домен должен резолвиться в IP сервера, а порты 80 и 443 быть открыты.
#
# Контактный e-mail для ACME здесь намеренно не задаётся: он необязателен, а
# директива `email` с пустым значением ломает разбор всего конфига. Если нужны
# уведомления об истечении сертификата, добавьте в начало файла блок:
#     { email you@example.com }

{$TRADEMAP_DOMAIN} {
	# Базовая авторизация закрывает всё приложение целиком.
	# Хеш пароля генерируется скриптом ./setup-auth.sh (bcrypt — то, что
	# basic_auth ожидает по умолчанию).
	basic_auth {
		{$TRADEMAP_BASICAUTH_USER} {$TRADEMAP_BASICAUTH_HASH}
	}

	reverse_proxy app:8765 {
		transport http {
			# Большая выгрузка собирается целиком до отправки заголовков,
			# поэтому ждём ответа долго. Значение read_timeout здесь
			# недопустимо — у транспорта http такой опции нет.
			response_header_timeout 10m
		}
	}

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
